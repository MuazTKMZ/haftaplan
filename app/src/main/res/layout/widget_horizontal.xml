<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Left Accent Summary Card -->
    <LinearLayout
        android:layout_width="106dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_dark_teal"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_h_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bugün"
            android:textColor="#DFF1EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_h_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Salı"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_h_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_pill_coral"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0/0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle Task List -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_h_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/widget_h_dot_1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_h_task_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Planlanan görev yok"
                android:textColor="#1C2120"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_h_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/widget_h_dot_2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_h_task_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text=""
                android:textColor="#5A6360"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_h_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_h_dot_3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_h_task_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text=""
                android:textColor="#5A6360"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Quick Add Action -->
    <ImageView
        android:id="@+id/widget_h_add_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_pill_coral"
        android:padding="8dp"
        android:src="@drawable/ic_widget_add"
        android:contentDescription="Yeni görev ekle" />
</LinearLayout>
