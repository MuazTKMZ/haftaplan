<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_v_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HAFTA PLANI"
                android:textColor="#125B50"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_v_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bugün"
                android:textColor="#1C2120"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_v_add_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_pill_coral"
            android:padding="6dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Yeni görev ekle" />
    </LinearLayout>

    <!-- Progress Pill -->
    <TextView
        android:id="@+id/widget_v_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_pill_sage"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Bugün: 0 / 0 görev"
        android:textColor="#0A3831"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Vertical Tasks (Up to 5 items) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_v_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:id="@+id/widget_v_dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_v_task_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Bugün için görev ekleyin"
                android:textColor="#1C2120"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_v_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:id="@+id/widget_v_dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_v_task_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="#1C2120"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_v_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:id="@+id/widget_v_dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_v_task_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="#1C2120"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_v_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:id="@+id/widget_v_dot_4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_v_task_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="#1C2120"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_v_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:id="@+id/widget_v_dot_5"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_pending"
                android:contentDescription="Görev durumu" />
            <TextView
                android:id="@+id/widget_v_task_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="#1C2120"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Week Summary -->
    <TextView
        android:id="@+id/widget_v_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Haftalık kalan: 0 görev"
        android:textColor="#5A6360"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
